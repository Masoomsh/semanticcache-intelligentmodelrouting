PINECONE_API_KEY=
PINECONE_INDEX=semantic-cache
PINECONE_NAMESPACE=semantic-cache
PINECONE_SIMILARITY_THRESHOLD=0.90
OLLAMA_BASE_URL=http://localhost:11434
STREAMLIT_API_URL=http://127.0.0.1:8011
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_SIMPLE_MODEL=qwen2.5:3b
OLLAMA_REASONING_MODEL=qwen2.5:14b
OLLAMA_CODING_MODEL=qwen2.5-coder:7b
OLLAMA_BASELINE_MODEL=qwen2.5:14b
CACHE_TTL_SECONDS=3600
CACHE_MAX_RESPONSE_CHARS=40000
AB_TEST_ENABLED=false
AB_TEST_TREATMENT_PERCENT=50
# Candidates are only compared within a category; include models adequate for that category.
MODEL_CANDIDATES_JSON={}
MODEL_PRICES_JSON={}
METRICS_DB_PATH=./data/metrics.sqlite3
# Optional ordered rules, e.g. [{"category":"coding","pattern":"\\b(python|typescript)\\b"}]
ROUTING_RULES_JSON=
